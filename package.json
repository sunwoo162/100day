{
  "name": "harufit",
  "private": true,
  "version": "0.1.5",
  "description": "하루핏 데스크톱 앱",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/desktop-dev.mjs",
    "build": "vite build",
    "desktop": "pnpm run build && electron .",
    "dist:desktop": "node scripts/build-desktop.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server/index.mjs",
    "db:reset": "node server/reset-db.mjs",
    "tracker:windows": "powershell -ExecutionPolicy Bypass -File scripts/windows-pc-tracker.ps1"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "site.harufit.desktop",
    "productName": "하루핏",
    "executableName": "하루핏",
    "directories": {
      "output": "desktop-release"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron/**/*",
      "server/**/*",
      "scripts/windows-active-app.ps1",
      "scripts/windows-active-app-watch.ps1",
      "scripts/windows-pc-tracker.ps1",
      "package.json",
      "!server/data/*.db",
      "!server/data/*.db-*",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "protocols": [
      {
        "name": "Harufit App",
        "schemes": [
          "harufit"
        ]
      }
    ],
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "oneClick": false,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "하루핏"
    }
  }
}
